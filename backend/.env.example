# ── APP ──────────────────────────────────────────────────────
APP_NAME=M.I.R.A.S
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this
FRONTEND_URL=http://localhost:3000

# ── DATABASE (PostgreSQL + PGVector) ─────────────────────────
# Install PostgreSQL first, then: CREATE EXTENSION vector;
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/miras
SYNC_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/miras

# ── SQLITE CHECKPOINTER (LangGraph short-term memory) ────────
SQLITE_CHECKPOINT_DB=./miras_checkpoints.db

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=60
JWT_REFRESH_TOKEN_EXPIRES=10080

# ── LOCAL LLM (Ollama) ────────────────────────────────────────
# Run: ollama pull qwen2.5:3b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# ── OPTIONAL: CLOUD LLM FALLBACK ─────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── SEARCH ────────────────────────────────────────────────────
# Free tier: https://app.tavily.com — 1000 requests/month free
# Leave empty to use DuckDuckGo only (completely free, no key needed)
TAVILY_API_KEY=

# ── EMAIL (optional for job/calendar features) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password

# ── MEMORY ────────────────────────────────────────────────────
MEMORY_TOP_K=5
MEMORY_EXTRACT_FACTS=true

# ── HITL ──────────────────────────────────────────────────────
HITL_TIMEOUT_SECONDS=300

